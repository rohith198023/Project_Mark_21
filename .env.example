# ==============================================================================
# JARVIS Environment Configuration
# Copy this file to '.env' and edit configuration variables.
# ==============================================================================

# General
ENV=development
DEBUG=true
LOG_LEVEL=info

# Shared Security & Local Encryption
# Used to encrypt integration credentials/tokens stored in the local databases
JARVIS_ENCRYPTION_KEY=dev-local-only-super-secret-encryption-key-128bits

# Relational Database (PostgreSQL)
POSTGRES_DB=jarvis_db
POSTGRES_USER=jarvis_user
POSTGRES_PASSWORD=jarvis_secure_pass

# Database URL parsed by internal adapter services
DATABASE_URL=postgresql://jarvis_user:jarvis_secure_pass@postgres:5432/jarvis_db

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Service Listening Ports (mapped in Compose)
API_PORT=8000
ORCHESTRATOR_PORT=8001
MEMORY_PORT=8002
BROWSER_PORT=8003
VOICE_PORT=8004
FRONTEND_PORT=3000

# ----------------------------------------------------------
# LLM Planner (Groq) — Phase 2, Chunk 5
# Get a free API key at: https://console.groq.com
# ----------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Planner confidence thresholds (optional, these are the defaults)
# PLANNER_CONFIDENCE_ROUTE=0.80
# PLANNER_CONFIDENCE_CLARIFY=0.50
